# Kopie als .env anlegen und ausfuellen. .env ist in .gitignore und
# gehoert NIE ins Repo.

# --- Orchestrator ---
# Gemeinsames Geheimnis fuer alle API-Aufrufe (Header X-Jarvis-Token).
# Erzeugen mit:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_TOKEN=bitte-ersetzen

# Adresse, auf der der Orchestrator hoert.
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8400

# Pfad zur SQLite-Datei (relativ zum Projektordner oder absolut).
JARVIS_DB=data/jarvis.db

# Zeitzone fuer die Job-Zeitfenster. Der Homeserver laeuft in UTC,
# gerechnet wird trotzdem in Ortszeit.
JARVIS_TZ=Europe/Berlin

# Nachtfenster fuer Jobs mit window=night (HH:MM, ueber Mitternacht erlaubt).
JARVIS_NIGHT_START=23:00
JARVIS_NIGHT_END=07:00

# Wie lange ein Worker einen Job halten darf, ohne sich zu melden.
# Laeuft der Lease ab, geht der Job zurueck in die Queue.
JARVIS_LEASE_SECONDS=300

# Ab wann ein Worker ohne Heartbeat als offline gilt.
JARVIS_HEARTBEAT_TIMEOUT=90

# debug | info | warning | error
JARVIS_LOG_LEVEL=info

# --- Spracherkennung (Phase 2) ---
# Sprachnachrichten werden vom Container wyoming-whisper transkribiert, der auf
# dem Homeserver schon fuer Home Assistant laeuft. Auf false setzen, wenn kein
# Whisper erreichbar ist - der Rest laeuft dann normal weiter.
JARVIS_STT_ENABLED=true
JARVIS_STT_HOST=127.0.0.1
JARVIS_STT_PORT=10300
JARVIS_STT_LANGUAGE=de
# Grosszuegig: Whisper braucht auf dem Homeserver etwa so lange wie die Aufnahme.
JARVIS_STT_TIMEOUT=300
